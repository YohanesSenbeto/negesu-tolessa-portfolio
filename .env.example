# ─────────────────────────────────────────────────────────────
#  Negesu Tolessa — Portfolio · Environment variables
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO metadata, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL="https://negesutolessa.vercel.app"

# MongoDB Atlas connection string (required for the contact form & analytics)
# Atlas: Connect -> Drivers -> copy connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name (recommended: negesu_portfolio)
MONGODB_DB="negesu_portfolio"

# Salt used to hash visitor IPs before storing (recommended: a long random string)
IP_HASH_SALT="change-me-to-a-long-random-string"

# Optional: email notifications on new contact messages (via Resend)
# Create a key at https://resend.com and verify your sending domain.
# Without these, messages are still stored in MongoDB.
RESEND_API_KEY=""
CONTACT_FROM="Negesu Portfolio <onboarding@resend.dev>"
CONTACT_TO="nagasu.tolessa@gmail.com"
